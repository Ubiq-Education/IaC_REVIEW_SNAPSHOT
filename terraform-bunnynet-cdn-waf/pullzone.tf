resource "bunnynet_pullzone" "main" {
  name                                  = local.pullzone_name
  add_canonical_header                  = var.pullzone_config.add_canonical_header
  allow_referers                        = var.pullzone_config.allow_referers
  block_ips                             = var.pullzone_config.block_ips
  block_no_referer                      = var.pullzone_config.block_no_referer
  block_post_requests                   = var.pullzone_config.block_post_requests
  block_referers                        = var.pullzone_config.block_referers
  block_root_path                       = var.pullzone_config.block_root_path
  cache_chunked                         = var.pullzone_config.cache_chunked
  cache_enabled                         = var.pullzone_config.cache_enabled
  cache_errors                          = var.pullzone_config.cache_errors
  cache_expiration_time                 = coalesce(var.pullzone_config.permacache_storagezone, 0) > 0 ? null : var.pullzone_config.cache_expiration_time
  cache_expiration_time_browser         = var.pullzone_config.cache_expiration_time_browser
  cache_stale                           = var.pullzone_config.cache_stale
  cache_vary                            = var.pullzone_config.cache_vary
  cache_vary_cookie                     = var.pullzone_config.cache_vary_cookie
  cache_vary_headers                    = var.pullzone_config.cache_vary_headers
  cache_vary_querystring                = var.pullzone_config.cache_vary_querystring
  cors_enabled                          = var.pullzone_config.cors_enabled
  cors_extensions                       = var.pullzone_config.cors_extensions
  disable_letsencrypt                   = var.pullzone_config.disable_letsencrypt
  errorpage_custom_content              = var.pullzone_config.errorpage_custom_content
  errorpage_custom_enabled              = var.pullzone_config.errorpage_custom_enabled
  errorpage_statuspage_code             = var.pullzone_config.errorpage_statuspage_code
  errorpage_statuspage_enabled          = var.pullzone_config.errorpage_statuspage_enabled
  errorpage_whitelabel                  = var.pullzone_config.errorpage_whitelabel
  limit_after                           = var.pullzone_config.limit_after
  limit_bandwidth                       = var.pullzone_config.limit_bandwidth
  limit_burst                           = var.pullzone_config.limit_burst
  limit_connections                     = var.pullzone_config.limit_connections
  limit_download_speed                  = var.pullzone_config.limit_download_speed
  limit_requests                        = var.pullzone_config.limit_requests
  log_anonymized                        = var.pullzone_config.log_anonymized
  log_anonymized_style                  = var.pullzone_config.log_anonymized_style
  log_enabled                           = var.pullzone_config.log_enabled
  log_forward_enabled                   = var.pullzone_config.log_forward_enabled
  log_forward_format                    = var.pullzone_config.log_forward_format
  log_forward_port                      = var.pullzone_config.log_forward_port
  log_forward_protocol                  = var.pullzone_config.log_forward_protocol
  log_forward_server                    = var.pullzone_config.log_forward_server
  log_forward_token                     = var.pullzone_config.log_forward_token
  log_storage_enabled                   = var.pullzone_config.log_storage_enabled
  log_storage_zone                      = var.pullzone_config.log_storage_zone
  optimizer_burrow                      = var.pullzone_config.optimizer_burrow
  optimizer_classes_force               = var.pullzone_config.optimizer_classes_force
  optimizer_dynamic_image_api           = var.pullzone_config.optimizer_dynamic_image_api
  optimizer_enabled                     = var.pullzone_config.optimizer_enabled
  optimizer_html_prerender              = var.pullzone_config.optimizer_html_prerender
  optimizer_html_to_markdown            = var.pullzone_config.optimizer_html_to_markdown
  optimizer_minify_css                  = var.pullzone_config.optimizer_minify_css
  optimizer_minify_js                   = var.pullzone_config.optimizer_minify_js
  optimizer_smartimage                  = var.pullzone_config.optimizer_smartimage
  optimizer_smartimage_desktop_maxwidth = var.pullzone_config.optimizer_smartimage_desktop_maxwidth
  optimizer_smartimage_desktop_quality  = var.pullzone_config.optimizer_smartimage_desktop_quality
  optimizer_smartimage_mobile_maxwidth  = var.pullzone_config.optimizer_smartimage_mobile_maxwidth
  optimizer_smartimage_mobile_quality   = var.pullzone_config.optimizer_smartimage_mobile_quality
  optimizer_watermark                   = var.pullzone_config.optimizer_watermark
  optimizer_watermark_borderoffset      = var.pullzone_config.optimizer_watermark_borderoffset
  optimizer_watermark_minsize           = var.pullzone_config.optimizer_watermark_minsize
  optimizer_watermark_position          = var.pullzone_config.optimizer_watermark_position
  optimizer_watermark_url               = var.pullzone_config.optimizer_watermark_url
  optimizer_webp                        = var.pullzone_config.optimizer_webp
  originshield_concurrency_limit        = var.pullzone_config.originshield_concurrency_limit
  originshield_concurrency_requests     = var.pullzone_config.originshield_concurrency_requests
  originshield_enabled                  = var.pullzone_config.originshield_enabled
  originshield_queue_requests           = var.pullzone_config.originshield_queue_requests
  originshield_queue_wait               = var.pullzone_config.originshield_queue_wait
  originshield_zone                     = var.pullzone_config.originshield_zone
  permacache_storagezone                = var.pullzone_config.permacache_storagezone
  request_coalescing_enabled            = var.pullzone_config.request_coalescing_enabled
  request_coalescing_timeout            = var.pullzone_config.request_coalescing_timeout
  s3_auth_enabled                       = var.pullzone_config.s3_auth_enabled
  s3_auth_key                           = var.pullzone_config.s3_auth_key
  s3_auth_region                        = var.pullzone_config.s3_auth_region
  s3_auth_secret                        = var.pullzone_config.s3_auth_secret
  safehop_connection_timeout            = var.pullzone_config.safehop_connection_timeout
  safehop_enabled                       = var.pullzone_config.safehop_enabled
  safehop_response_timeout              = var.pullzone_config.safehop_response_timeout
  safehop_retry_count                   = var.pullzone_config.safehop_retry_count
  safehop_retry_delay                   = var.pullzone_config.safehop_retry_delay
  safehop_retry_reasons                 = var.pullzone_config.safehop_retry_reasons
  sort_querystring                      = var.pullzone_config.sort_querystring
  strip_cookies                         = var.pullzone_config.strip_cookies
  tls_level                             = var.pullzone_config.tls_level
  tls_support                           = var.pullzone_config.tls_support
  token_auth_enabled                    = var.pullzone_config.token_auth_enabled
  token_auth_ip_validation              = var.pullzone_config.token_auth_ip_validation
  use_background_update                 = var.pullzone_config.use_background_update
  websockets_enabled                    = var.pullzone_config.websockets_enabled
  websockets_max_connections            = var.pullzone_config.websockets_max_connections

  origin {
    type                        = var.pullzone_config.origin.type
    url                         = var.pullzone_config.origin.url
    verify_ssl                  = var.pullzone_config.origin.verify_ssl
    follow_redirects            = var.pullzone_config.origin.follow_redirects
    forward_host_header         = var.pullzone_config.origin.forward_host_header
    host_header                 = var.pullzone_config.origin.host_header
    middleware_script           = var.pullzone_config.origin.middleware_script
    script                      = var.pullzone_config.origin.script
    script_execute_before_cache = var.pullzone_config.origin.script_execute_before_cache
    storagezone                 = var.pullzone_config.origin.storagezone
    container_app_id            = var.pullzone_config.origin.container_app_id
    container_endpoint_id       = var.pullzone_config.origin.container_endpoint_id
    dns_port                    = var.pullzone_config.origin.dns_port
    dns_scheme                  = var.pullzone_config.origin.dns_scheme
  }

  routing {
    tier                 = var.pullzone_config.routing.tier
    zones                = var.pullzone_config.routing.zones
    blocked_countries    = var.pullzone_config.routing.blocked_countries
    redirected_countries = var.pullzone_config.routing.redirected_countries
    filters = (var.pullzone_config.routing.filters != null ? var.pullzone_config.routing.filters :
      var.pullzone_config.origin.middleware_script != null || var.pullzone_config.origin.type == "ComputeScript" ? ["scripting"] :
    ["all"])
  }
}
